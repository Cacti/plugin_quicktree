msgstr "Tehirizo ao amin'ny Sampana"

#: quicktree.php
msgid "Clear All Graphs"
msgstr "Fafao daholo ny Kisary"

#: quicktree.php
msgid "Graph Added to QuickTree"
msgstr "Nampiana tao amin'ny QuickTree ny Kisary"

#: quicktree.php
#, php-format
msgid "Graph %s added to QuickTree.  Goto the QuickTree page to move all Graphs to a new or existing Tree."
msgstr "Nampiana tao amin'ny QuickTree ny kisary %s.  Mandehana any amin'ny pejy QuickTree hamindrana ny kisary rehetra mankany amin'ny Hazo vaovao na efa misy."

#: quicktree.php
msgid "Graph Not Added to QuickTree"
msgstr "Tsy nampiana tao amin'ny QuickTree ny Kisary"

#: quicktree.php
#, php-format
msgid "Graph %s was NOT added to QuickTree as it's already there waiting to be placed on a Tree.  Goto the QuickTree page to move all Graphs to a new or existing Tree."
msgstr "TSY nampiana tao amin'ny QuickTree ny kisary %s satria efa ao izy ary miandry hapetraka ao amin'ny Hazo.  Mandehana any amin'ny pejy QuickTree hamindrana ny kisary rehetra mankany amin'ny Hazo vaovao na efa misy."

#: quicktree.php
msgid "Graph Not Specified.  Not added to QuickTree"
msgstr "Tsy voafaritra ny Kisary.  Tsy nampiana tao amin'ny QuickTree"

#: quicktree.php
msgid "No Graph was added to QuickTree as no Graph was specified."
msgstr "Tsy nisy kisary nampiana tao amin'ny QuickTree satria tsy nisy kisary voafaritra."

#: quicktree.php
msgid "Click 'Continue' to Add the following Tree."
msgstr "Tsindrio ny 'Tohizo' hanampiana ity Hazo manaraka ity."

#: quicktree.php
msgid "Tree Name"
msgstr "Anaran'ny Hazo"

#: quicktree.php
msgid "New Tree"
msgstr "Hazo Vaovao"

#: quicktree.php
msgid "Branch Name"
msgstr "Anaran'ny Sampana"

