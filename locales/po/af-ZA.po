msgid "Graph Added to QuickTree"
msgstr "Grafiek by QuickTree gevoeg"

#: quicktree.php
#, php-format
msgid "Graph %s added to QuickTree.  Goto the QuickTree page to move all Graphs to a new or existing Tree."
msgstr "Grafiek %s is by QuickTree gevoeg. Gaan na die QuickTree-bladsy om alle grafieke na 'n nuwe of bestaande boom te skuif."

#: quicktree.php
msgid "Graph Not Added to QuickTree"
msgstr "Grafiek nie by QuickTree gevoeg nie"

#: quicktree.php
#, php-format
msgid "Graph %s was NOT added to QuickTree as it's already there waiting to be placed on a Tree.  Goto the QuickTree page to move all Graphs to a new or existing Tree."
msgstr "Grafiek %s is NIE by QuickTree gevoeg nie omdat dit reeds daar wag om op 'n boom geplaas te word. Gaan na die QuickTree-bladsy om alle grafieke na 'n nuwe of bestaande boom te skuif."

#: quicktree.php
msgid "Graph Not Specified.  Not added to QuickTree"
msgstr "Grafiek nie gespesifiseer nie. Nie by QuickTree gevoeg nie"

#: quicktree.php
msgid "No Graph was added to QuickTree as no Graph was specified."
msgstr "Geen grafiek is by QuickTree gevoeg nie omdat geen grafiek gespesifiseer is nie."

#: quicktree.php
msgid "Click 'Continue' to Add the following Tree."
msgstr "Klik op 'Gaan voort' om die volgende boom by te voeg."

