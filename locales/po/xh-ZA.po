#: quicktree.php
msgid "Save To New Tree"
msgstr "Gcina KuMthi Omtsha"

#: quicktree.php
msgid "Save To Branch"
msgstr "Gcina KwIsebe"

#: quicktree.php
msgid "Clear All Graphs"
msgstr "Sula Zonke Iigrafu"

#: quicktree.php
msgid "Graph Added to QuickTree"
msgstr "Igrafu Yongezwe kwi-QuickTree"

#: quicktree.php
#, php-format
msgid "Graph %s added to QuickTree.  Goto the QuickTree page to move all Graphs to a new or existing Tree."
msgstr "Igrafu %s yongezwe kwi-QuickTree. Yiya kwiphepha le-QuickTree ukuze ushenxise zonke Iigrafu kuMthi omtsha okanye okhoyo."

#: quicktree.php
msgid "Graph Not Added to QuickTree"
msgstr "Igrafu Ayongezwanga kwi-QuickTree"

#: quicktree.php
#, php-format
msgid "Graph %s was NOT added to QuickTree as it's already there waiting to be placed on a Tree.  Goto the QuickTree page to move all Graphs to a new or existing Tree."
msgstr "Igrafu %s AYONGEZWANGA kwi-QuickTree kuba sele ikhona ilindele ukufakwa kuMthi. Yiya kwiphepha le-QuickTree ukuze ushenxise zonke Iigrafu kuMthi omtsha okanye okhoyo."

#: quicktree.php
msgid "Graph Not Specified.  Not added to QuickTree"
msgstr "Igrafu Ayichazwanga. Ayongezwanga kwi-QuickTree"

#: quicktree.php
msgid "No Graph was added to QuickTree as no Graph was specified."
msgstr "Akukho Grafu yongezwe kwi-QuickTree kuba akukho Grafu ichaziweyo."

#: quicktree.php
msgid "Click 'Continue' to Add the following Tree."
msgstr "Cofa u-'Qhubeka' ukuze Wongeze lo Mthi ulandelayo."

#: quicktree.php
msgid "Tree Name"
msgstr "Igama Lomthi"

#: quicktree.php
msgid "New Tree"
msgstr "Umthi Omtsha"

#: quicktree.php
msgid "Branch Name"
msgstr "Igama Lesebe"

#: quicktree.php setup.php
msgid "QuickTree"
msgstr "QuickTree"

#: quicktree.php
msgid "Add To Branch"
msgstr "Yongeza KwIsebe"

#: quicktree.php
msgid "Cancel"
msgstr "Rhoxisa"

#: quicktree.php
msgid "Continue"
msgstr "Qhubeka"

#: quicktree.php
msgid "Click 'Continue' to Add the following Tree Branch."
msgstr "Cofa u-'Qhubeka' ukuze Wongeze eli Sebe loMthi lilandelayo."

#: quicktree.php
msgid "Add to which Graph Tree?"
msgstr "Yongeza kuwuphi Umthi weGrafu?"

#: quicktree.php
msgid "QuickTree has Created Tree and/or Branch and added Graphs"
msgstr "I-QuickTree Yenze Umthi kunye/okanye Isebe yaza yongeza Iigrafu"

#: quicktree.php
msgid "QuickTree has no Graphs Queued"
msgstr "I-QuickTree ayinazigrafu Zikumgca"

#: quicktree.php
msgid "Information/Directions"
msgstr "Ulwazi/Izikhokelo"

#: quicktree.php
msgid "The Graphs below are Queue to be added to a Cacti Tree.  You may keep them here for as long as you like, or you can perform one of the following actions"
msgstr "Iigrafu ezingezantsi zikumgca wokongezwa kuMthi we-Cacti. Ungazigcina apha ixesha elide kangangoko uthanda, okanye ungenza esinye sezi zenzo zilandelayo"

#: quicktree.php
msgid "Save your selection to a new Graph Tree so you can keep them for later and work on something new."
msgstr "Gcina ukhetho lwakho kuMthi omtsha weGrafu ukuze uzigcinele kamva kwaye usebenze kwenye into entsha."

#: quicktree.php
msgid "Save your selection as a branch to an existing tree so that they appear in a specific section of an existing tree."
msgstr "Gcina ukhetho lwakho njengesebe kumthi okhoyo ukuze zivele kwicandelo elithile lomthi okhoyo."

#: quicktree.php
msgid "Clear all graphs"
msgstr "Sula zonke iigrafu"

#: quicktree.php
msgid "Clear the Graphs on this page from the Graphs Queue so that you have a blank QuickTree ready for new selections"
msgstr "Sula Iigrafu ezikweli phepha kuMgca weeGrafu ukuze ube ne-QuickTree engenanto elungele ukhetho olutsha"

#: quicktree.php
msgid "You can manage the individual graphs that appear here by clicking:"
msgstr "Ungalawula iigrafu nganye ezivela apha ngokucofa:"

#: quicktree.php
msgid "Add"
msgstr "Yongeza"

#: quicktree.php
msgid "Graph View Page"
msgstr "Iphepha loKujonga Igrafu"

#: quicktree.php
#, php-format
msgid "This icon is next to a Graph on the %s tab."
msgstr "Le ayikhoni ikufuphi neGrafu kwithebhu ethi %s."

#: quicktree.php
msgid "Delete"
msgstr "Cima"

#: quicktree.php
msgid "This icon next to the Graphs below to remove them from the QuickTree Queue."
msgstr "Le ayikhoni ikufuphi neeGrafu ezingezantsi ukuze uzisuse kuMgca we-QuickTree."

#: quicktree.php
msgid "Note:"
msgstr "Qaphela:"

#: quicktree.php
msgid "Adding, removing or clearing on this page does not affect any other parts of Cacti (only Creating/Saving does)"
msgstr "Ukongeza, ukususa okanye ukusula kweli phepha akuchaphazeli naziphi na ezinye iindawo ze-Cacti (kuphela Ukudala/Ukugcina okuchaphazelayo)"

#: quicktree.php
msgid "Actions"
msgstr "Izenzo"

#: quicktree.php
msgid "Remove This Graph From QuickTree"
msgstr "Susa Le Grafu Kwi-QuickTree"

#: quicktree.php
msgid "No Graphs Added Yet"
msgstr "Akukho Grafu Zongezweyo Okwangoku"

