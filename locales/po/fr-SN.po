#, php-format
msgid "Graph %s added to QuickTree.  Goto the QuickTree page to move all Graphs to a new or existing Tree."
msgstr "Le graphique %s a été ajouté à QuickTree. Rendez-vous sur la page QuickTree pour déplacer tous les graphiques vers un nouvel arbre ou un arbre existant."

#: quicktree.php
msgid "Graph Not Added to QuickTree"
msgstr "Graphique non ajouté à QuickTree"

#: quicktree.php
#, php-format
msgid "Graph %s was NOT added to QuickTree as it's already there waiting to be placed on a Tree.  Goto the QuickTree page to move all Graphs to a new or existing Tree."
msgstr "Le graphique %s n'a PAS été ajouté à QuickTree car il s'y trouve déjà en attente d'être placé dans un arbre. Rendez-vous sur la page QuickTree pour déplacer tous les graphiques vers un nouvel arbre ou un arbre existant."

