#: quicktree.php
msgid "Save To New Tree"
msgstr "Sačuvaj u novo stablo"

#: quicktree.php
msgid "Save To Branch"
msgstr "Sačuvaj u granu"

#: quicktree.php
msgid "Clear All Graphs"
msgstr "Očisti sve grafikone"

#: quicktree.php
msgid "Graph Added to QuickTree"
msgstr "Grafikon je dodan u QuickTree"

#: quicktree.php
#, php-format
msgid "Graph %s added to QuickTree.  Goto the QuickTree page to move all Graphs to a new or existing Tree."
msgstr "Grafikon %s je dodan u QuickTree. Idite na stranicu QuickTree da biste premjestili sve grafikone u novo ili postojeće stablo."

#: quicktree.php
msgid "Graph Not Added to QuickTree"
msgstr "Grafikon nije dodan u QuickTree"

#: quicktree.php
#, php-format
msgid "Graph %s was NOT added to QuickTree as it's already there waiting to be placed on a Tree.  Goto the QuickTree page to move all Graphs to a new or existing Tree."
msgstr "Grafikon %s NIJE dodan u QuickTree jer se već nalazi tamo i čeka postavljanje na stablo. Idite na stranicu QuickTree da biste premjestili sve grafikone u novo ili postojeće stablo."

#: quicktree.php
msgid "Graph Not Specified.  Not added to QuickTree"
msgstr "Grafikon nije naveden. Nije dodan u QuickTree"

#: quicktree.php
msgid "No Graph was added to QuickTree as no Graph was specified."
msgstr "Nijedan grafikon nije dodan u QuickTree jer nijedan grafikon nije naveden."

#: quicktree.php
msgid "Click 'Continue' to Add the following Tree."
msgstr "Kliknite 'Nastavi' da biste dodali sljedeće stablo."

#: quicktree.php
msgid "Tree Name"
msgstr "Naziv stabla"

#: quicktree.php
msgid "New Tree"
msgstr "Novo stablo"

#: quicktree.php
msgid "Branch Name"
msgstr "Naziv grane"

#: quicktree.php setup.php
msgid "QuickTree"
msgstr "QuickTree"

#: quicktree.php
msgid "Add To Branch"
msgstr "Dodaj u granu"

#: quicktree.php
msgid "Cancel"
msgstr "Otkaži"

#: quicktree.php
msgid "Continue"
msgstr "Nastavi"

#: quicktree.php
msgid "Click 'Continue' to Add the following Tree Branch."
msgstr "Kliknite 'Nastavi' da biste dodali sljedeću granu stabla."

#: quicktree.php
msgid "Add to which Graph Tree?"
msgstr "U koje stablo grafikona dodati?"

#: quicktree.php
msgid "QuickTree has Created Tree and/or Branch and added Graphs"
msgstr "QuickTree je kreirao stablo i/ili granu te dodao grafikone"

#: quicktree.php
msgid "QuickTree has no Graphs Queued"
msgstr "QuickTree nema grafikona u redu čekanja"

#: quicktree.php
msgid "Information/Directions"
msgstr "Informacije/Upute"

#: quicktree.php
msgid "The Graphs below are Queue to be added to a Cacti Tree.  You may keep them here for as long as you like, or you can perform one of the following actions"
msgstr "Grafikoni ispod su u redu čekanja za dodavanje u Cacti stablo. Možete ih zadržati ovdje koliko god želite ili izvršiti jednu od sljedećih radnji"

#: quicktree.php
msgid "Save your selection to a new Graph Tree so you can keep them for later and work on something new."
msgstr "Sačuvajte svoj odabir u novo stablo grafikona kako biste ih sačuvali za kasnije i radili na nečemu novom."

#: quicktree.php
msgid "Save your selection as a branch to an existing tree so that they appear in a specific section of an existing tree."
msgstr "Sačuvajte svoj odabir kao granu u postojeće stablo kako bi se pojavili u određenom dijelu postojećeg stabla."

#: quicktree.php
msgid "Clear all graphs"
msgstr "Očisti sve grafikone"

#: quicktree.php
msgid "Clear the Graphs on this page from the Graphs Queue so that you have a blank QuickTree ready for new selections"
msgstr "Očistite grafikone na ovoj stranici iz reda čekanja grafikona kako biste imali prazan QuickTree spreman za nove odabire"

#: quicktree.php
msgid "You can manage the individual graphs that appear here by clicking:"
msgstr "Pojedinačnim grafikonima koji se ovdje pojavljuju možete upravljati klikom na:"

#: quicktree.php
msgid "Add"
msgstr "Dodaj"

#: quicktree.php
msgid "Graph View Page"
msgstr "Stranica prikaza grafikona"

#: quicktree.php
#, php-format
msgid "This icon is next to a Graph on the %s tab."
msgstr "Ova ikona se nalazi pored grafikona na kartici %s."

#: quicktree.php
msgid "Delete"
msgstr "Obriši"

#: quicktree.php
msgid "This icon next to the Graphs below to remove them from the QuickTree Queue."
msgstr "Ova ikona pored grafikona ispod služi za njihovo uklanjanje iz reda čekanja QuickTree."

#: quicktree.php
msgid "Note:"
msgstr "Napomena:"

#: quicktree.php
msgid "Adding, removing or clearing on this page does not affect any other parts of Cacti (only Creating/Saving does)"
msgstr "Dodavanje, uklanjanje ili čišćenje na ovoj stranici ne utiče ni na koje druge dijelove Cactija (samo kreiranje/čuvanje utiče)"

#: quicktree.php
msgid "Actions"
msgstr "Radnje"

#: quicktree.php
msgid "Remove This Graph From QuickTree"
msgstr "Ukloni ovaj grafikon iz QuickTree"

#: quicktree.php
msgid "No Graphs Added Yet"
msgstr "Još nije dodan nijedan grafikon"

