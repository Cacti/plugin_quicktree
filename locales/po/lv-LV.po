#: quicktree.php
msgid "Save To New Tree"
msgstr "Saglabāt jaunā kokā"

#: quicktree.php
msgid "Save To Branch"
msgstr "Saglabāt zarā"

#: quicktree.php
msgid "Clear All Graphs"
msgstr "Notīrīt visus grafikus"

#: quicktree.php
msgid "Graph Added to QuickTree"
msgstr "Grafiks pievienots QuickTree"

#: quicktree.php
#, php-format
msgid "Graph %s added to QuickTree.  Goto the QuickTree page to move all Graphs to a new or existing Tree."
msgstr "Grafiks %s pievienots QuickTree. Dodieties uz QuickTree lapu, lai pārvietotu visus grafikus uz jaunu vai esošu koku."

#: quicktree.php
msgid "Graph Not Added to QuickTree"
msgstr "Grafiks netika pievienots QuickTree"

#: quicktree.php
#, php-format
msgid "Graph %s was NOT added to QuickTree as it's already there waiting to be placed on a Tree.  Goto the QuickTree page to move all Graphs to a new or existing Tree."
msgstr "Grafiks %s NETIKA pievienots QuickTree, jo tas jau tur atrodas un gaida pievienošanu kokam. Dodieties uz QuickTree lapu, lai pārvietotu visus grafikus uz jaunu vai esošu koku."

#: quicktree.php
msgid "Graph Not Specified.  Not added to QuickTree"
msgstr "Grafiks nav norādīts. Netika pievienots QuickTree"

#: quicktree.php
msgid "No Graph was added to QuickTree as no Graph was specified."
msgstr "Neviens grafiks netika pievienots QuickTree, jo nebija norādīts neviens grafiks."

#: quicktree.php
msgid "Click 'Continue' to Add the following Tree."
msgstr "Noklikšķiniet uz 'Turpināt', lai pievienotu šo koku."

#: quicktree.php
msgid "Tree Name"
msgstr "Koka nosaukums"

#: quicktree.php
msgid "New Tree"
msgstr "Jauns koks"

#: quicktree.php
msgid "Branch Name"
msgstr "Zara nosaukums"

#: quicktree.php setup.php
msgid "QuickTree"
msgstr "QuickTree"

#: quicktree.php
msgid "Add To Branch"
msgstr "Pievienot zaram"

#: quicktree.php
msgid "Cancel"
msgstr "Atcelt"

#: quicktree.php
msgid "Continue"
msgstr "Turpināt"

#: quicktree.php
msgid "Click 'Continue' to Add the following Tree Branch."
msgstr "Noklikšķiniet uz 'Turpināt', lai pievienotu šo koka zaru."

#: quicktree.php
msgid "Add to which Graph Tree?"
msgstr "Kuram grafiku kokam pievienot?"

#: quicktree.php
msgid "QuickTree has Created Tree and/or Branch and added Graphs"
msgstr "QuickTree izveidoja koku un/vai zaru un pievienoja grafikus"

#: quicktree.php
msgid "QuickTree has no Graphs Queued"
msgstr "QuickTree rindā nav grafiku"

#: quicktree.php
msgid "Information/Directions"
msgstr "Informācija/Norādījumi"

#: quicktree.php
msgid "The Graphs below are Queue to be added to a Cacti Tree.  You may keep them here for as long as you like, or you can perform one of the following actions"
msgstr "Tālāk norādītie grafiki atrodas rindā pievienošanai Cacti kokam. Varat tos šeit paturēt cik ilgi vēlaties vai veikt kādu no tālāk norādītajām darbībām"

#: quicktree.php
msgid "Save your selection to a new Graph Tree so you can keep them for later and work on something new."
msgstr "Saglabājiet atlasi jaunā grafiku kokā, lai to paturētu vēlākam laikam un turpinātu darbu pie kā jauna."

#: quicktree.php
msgid "Save your selection as a branch to an existing tree so that they appear in a specific section of an existing tree."
msgstr "Saglabājiet atlasi kā zaru esošā kokā, lai grafiki parādītos noteiktā esoša koka sadaļā."

#: quicktree.php
msgid "Clear all graphs"
msgstr "Notīrīt visus grafikus"

#: quicktree.php
msgid "Clear the Graphs on this page from the Graphs Queue so that you have a blank QuickTree ready for new selections"
msgstr "Notīriet šajā lapā redzamos grafikus no grafiku rindas, lai QuickTree būtu tukšs un gatavs jaunām atlasēm"

#: quicktree.php
msgid "You can manage the individual graphs that appear here by clicking:"
msgstr "Šeit redzamos atsevišķos grafikus varat pārvaldīt, noklikšķinot uz:"

#: quicktree.php
msgid "Add"
msgstr "Pievienot"

#: quicktree.php
msgid "Graph View Page"
msgstr "Grafiku skata lapa"

#: quicktree.php
#, php-format
msgid "This icon is next to a Graph on the %s tab."
msgstr "Šī ikona atrodas blakus grafikam cilnē %s."

#: quicktree.php
msgid "Delete"
msgstr "Dzēst"

#: quicktree.php
msgid "This icon next to the Graphs below to remove them from the QuickTree Queue."
msgstr "Šī ikona atrodas blakus tālāk redzamajiem grafikiem, lai tos noņemtu no QuickTree rindas."

#: quicktree.php
msgid "Note:"
msgstr "Piezīme:"

#: quicktree.php
msgid "Adding, removing or clearing on this page does not affect any other parts of Cacti (only Creating/Saving does)"
msgstr "Pievienošana, noņemšana vai notīrīšana šajā lapā neietekmē citas Cacti daļas (to dara tikai izveidošana/saglabāšana)"

#: quicktree.php
msgid "Actions"
msgstr "Darbības"

#: quicktree.php
msgid "Remove This Graph From QuickTree"
msgstr "Noņemt šo grafiku no QuickTree"

#: quicktree.php
